<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Ad-hoc signing without an Apple certificate: without waiving library
    validation the system kills the app as it loads the native module
    better-sqlite3. Once a real Developer ID exists these two keys can go.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!--
    V8 compiles code on the fly, and without the JIT entitlement it cannot
    reserve executable memory: the app dies with «Failed to reserve virtual
    memory for CodeRange». allow-unsigned-executable-memory is not needed
    here — on Apple Silicon it actually gets in the way.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>

{
  "name": "forestplant-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Desktop app that pulls forest fund data out of the forestplant.gharysh.kz GIS into a local SQLite database — browse, query and export to KML, GeoJSON and CSV",
  "keywords": [
    "gis",
    "arcgis",
    "forestry",
    "kml",
    "geojson",
    "google-earth",
    "electron",
    "sqlite",
    "kazakhstan"
  ],
  "homepage": "https://github.com/fedyunin/forestplant-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedyunin/forestplant-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/fedyunin/forestplant-desktop/issues"
  },
  "author": "Alexey Fedyunin <fedyunin@ipoint.ru>",
  "license": "MIT",
  "type": "module",
  "main": "src/main/bootstrap.cjs",
  "scripts": {
    "start": "node scripts/start.js",
    "load": "node src/cli/load.js --raw db/raw --db db/forest.sqlite",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/start.js --smoke",
    "sync": "node src/cli/sync.js --raw db/raw --db db/forest.sqlite",
    "dist": "electron-builder --mac --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
